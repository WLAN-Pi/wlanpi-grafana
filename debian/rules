#!/usr/bin/make -f
# You must remove unused comment lines for the released package.
# export DH_VERBOSE = 1
#export DEB_BUILD_MAINT_OPTIONS = hardening=+all
#export DEB_CFLAGS_MAINT_APPEND  = -Wall -pedantic
#export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed

export DH_VIRTUALENV_INSTALL_ROOT=/opt
export PYBUILD_NAME=wlanpi-grafana
export PYBUILD_SYSTEM=pyproject

PACKAGE=$(shell dh_listpackages)
VERSION=$(shell parsechangelog | grep ^Version: | sed -re 's/[^0-9]+([^-]+).*/\1/')
SDIST_DIR=debian/$(PACKAGE)-$(VERSION)

SNAKE=/usr/bin/python3

DH_VENV_DIR=debian/$(PACKAGE)$(DH_VIRTUALENV_INSTALL_ROOT)/$(PACKAGE)
PKG_PREFIX=debian/wlanpi-grafana

%:
	dh $@ --with python-virtualenv --buildsystem=pybuild

.PHONY: override_dh_virtualenv override_dh_installexamples 

override_dh_auto_install:
	dh_auto_install -- prefix=/usr

override_dh_installsystemd:
	dh_installsystemd --no-start --no-enable --restart-after-upgrade

# we don't really want dwz to do anything to our files.
override_dh_dwz:

override_dh_installexamples:
	dh_installexamples -A -X__pycache__

# pip only builds the venv. Nothing on the device runs it, and a shipped copy
# goes stale with no manifest left for Dependabot to watch.
override_dh_virtualenv:
	dh_virtualenv \
		--install-suffix "wlanpi-grafana" \
		--builtin-venv \
		--python ${SNAKE}
	PYTHONDONTWRITEBYTECODE=1 $(DH_VENV_DIR)/bin/python -m pip uninstall --yes pip
